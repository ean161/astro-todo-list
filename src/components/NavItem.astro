---
const { title, to } = Astro.props;
const path = Astro.originPathname;

const isActive = path == to;
---

<a href={to} class={"flex items-center space-x-2 text-gray-600 " + (isActive && "font-bold bg-green-950 text-green-400 px-3 py-1 rounded-full")}>
    <span class={"" + (isActive && "text-white")}>{title}</span>
    {isActive && <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mouse-pointer2-icon lucide-mouse-pointer-2"><path d="M4.037 4.688a.495.495 0 0 1 .651-.651l16 6.5a.5.5 0 0 1-.063.947l-6.124 1.58a2 2 0 0 0-1.438 1.435l-1.579 6.126a.5.5 0 0 1-.947.063z"/></svg> }
</a>